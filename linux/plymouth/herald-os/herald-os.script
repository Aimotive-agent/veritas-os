// Herald OS boot splash. Deep-blue field, the Herald mark fading in, a progress bar on a faint track
// for the boot sequence, and plain password prompts for encrypted disks.

Window.SetBackgroundTopColor(0.016, 0.067, 0.247);
Window.SetBackgroundBottomColor(0.008, 0.035, 0.150);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

// Fade the mark in.
logo.opacity = 0;
logo.sprite.SetOpacity(0);

progress.width = 240;
progress.height = 3;
progress.x = Window.GetWidth() / 2 - progress.width / 2;
progress.y = logo.y + logo.image.GetHeight() + 56;
// A short boot only fills the first sliver of the bar; without a track that reads as a stray dash.
progress.track = Sprite(Image("bar.png").Scale(progress.width, progress.height));
progress.track.SetOpacity(0.18);
progress.track.SetPosition(progress.x, progress.y, 5);
progress.bar = Sprite();
progress.bar.SetPosition(progress.x, progress.y, 6);

status.sprite = Sprite();
status.sprite.SetPosition(Window.GetWidth() / 2, progress.y + 24, 7);

fun refresh_callback () {
  if (logo.opacity < 1) {
    logo.opacity += 0.04;
    logo.sprite.SetOpacity(logo.opacity);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun boot_progress_callback (duration, progress_fraction) {
  width = Math.Int(progress.width * progress_fraction);
  if (width < 1) width = 1;
  progress.bar.SetImage(Image("bar.png").Scale(width, progress.height));
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

fun display_password_callback (prompt, bullets) {
  text = "";
  for (i = 0; i < bullets; i++) text += "•";
  msg = Image.Text(prompt + "  " + text, 1, 1, 1, 1, "Sans 14");
  status.sprite.SetImage(msg);
  status.sprite.SetX(Window.GetWidth() / 2 - msg.GetWidth() / 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
  status.sprite.SetImage(Image.Text("", 1, 1, 1));
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback (text) {
  msg = Image.Text(text, 0.75, 0.82, 1, 1, "Sans 12");
  status.sprite.SetImage(msg);
  status.sprite.SetX(Window.GetWidth() / 2 - msg.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback () {
  logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);

{
  "name": "veritas-os",
  "productName": "Veritas OS",
  "version": "0.1.0",
  "private": true,
  "description": "Veritas OS: the Herald OS shell, cloned and extended with multi-agent support",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --packages=external --sourcemap --outfile=dist/electron/main.mjs",
    "build:preload": "esbuild preload/index.ts --bundle --platform=node --format=cjs --external:electron --packages=external --outfile=dist/electron/preload.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "electron ."
  },
  "dependencies": {
    "@herald-os/client": "*",
    "@nanostores/react": "1.1.0",
    "@tabler/icons-react": "3.46.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "ag-psd": "31.0.2",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dbus-next": "0.10.2",
    "nanostores": "1.4.2",
    "node-pty": "1.1.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "esbuild": "^0.28.2",
    "vite": "^7.3.7",
    "@vitejs/plugin-react": "^5.0.0"
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
